      "availabilities": [
        { "participantKey": "djOnly", "status": "available", "roleKeys": ["dj"] }
      ],
      "preAssignedSlots": []
    },
    "drawSteps": [{ "mode": "full" }],
    "expected": {
      "totalAssignedSlots": 1,
      "rolesByParticipant": { "djOnly": ["dj"] }
    }
  },
