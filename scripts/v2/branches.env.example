# HatCast V2 — noms de branches Git (copier vers branches.env ou éditer branches.env)
# Lors d’un renommage : mettre à jour aussi .github/workflows/deploy-v2-cloud-run.yml
# et les Deployment branches des environnements GitHub (development / staging / production).

HATCAST_V2_BRANCH_DEV=v2
HATCAST_V2_BRANCH_STAGING=staging-v2
