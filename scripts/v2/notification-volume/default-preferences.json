    "ORG_TEAM_REGRESSED": { "push": false, "email": false },
    "ORG_SCOPE_GRANTED": { "push": false, "email": false },
    "ORG_TEAM_COMPLETE": { "push": false, "email": false },
    "ORG_COMPOSITION_INCOMPLETE": { "push": false, "email": false },
